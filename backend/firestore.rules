rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isMember(eventId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/events/$(eventId)/members/$(request.auth.uid));
    }

    function isOrganizer(eventId) {
      return isMember(eventId) &&
        get(/databases/$(database)/documents/events/$(eventId)/members/$(request.auth.uid)).data.role == 'organizer';
    }

    match /users/{userId} {
      // Phone number, identity fields and account lifecycle are server-owned.
      // Clients synchronize them through syncMyUserProfile/updateDisplayName/
      // deleteMyAccount callables so a forged phone number cannot be persisted.
      allow read: if isSelf(userId);
      allow create, update, delete: if false;

      match /faceProfile/{doc} {
        allow read: if isSelf(userId);
        allow create, update: if isSelf(userId)
          && request.resource.data.userId == userId;
        // Deletion must also scrub event-scoped biometric copies and matches.
        allow delete: if false;
      }

      match /privacy/{doc} {
        allow read: if isSelf(userId);
        // Consent acceptance may be persisted by the signed-in user. Withdrawal
        // is callable-only because it must erase all biometric derivatives.
        allow create, update: if isSelf(userId)
          && request.resource.data.userId == userId
          && request.resource.data.get('withdrawnAt', null) == null;
        allow delete: if false;
      }

      match /eventRefs/{eventId} {
        allow read: if isSelf(userId);
        allow write: if false;
      }

      match /pendingInvites/{eventId} {
        allow read: if isSelf(userId);
        allow write: if false;
      }

      match /notifications/{notificationId} {
        allow read: if isSelf(userId);
        allow create, delete: if false;
        allow update: if isSelf(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      }
    }

    match /joinCodes/{code} {
      allow read, write: if false;
    }

    match /inviteTokens/{token} {
      allow read, write: if false;
    }

    match /events/{eventId} {
      allow get: if isMember(eventId);
      allow list: if false;
      allow create: if false;

      // The existing end-event UI keeps a single tightly constrained direct
      // transition: active -> endedByOrganizer. Reopen/delete/restore and all
      // event detail/date edits go through trusted callables.
      allow update: if isOrganizer(eventId)
        && resource.data.status == 'active'
        && request.resource.data.status == 'endedByOrganizer'
        && request.resource.data.id == resource.data.id
        && request.resource.data.joinCode == resource.data.joinCode
        && request.resource.data.inviteToken == resource.data.inviteToken
        && request.resource.data.creatorUserId == resource.data.creatorUserId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.name == resource.data.name
        && request.resource.data.category == resource.data.category
        && request.resource.data.get('coverImagePath', null) == resource.data.get('coverImagePath', null)
        && request.resource.data.get('locationName', null) == resource.data.get('locationName', null)
        && request.resource.data.startsAt == resource.data.startsAt
        && request.resource.data.endsAt == resource.data.endsAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']);

      allow delete: if false;

      match /members/{userId} {
        allow read: if isMember(eventId);
        // Roles and sharingEnabled are server-authoritative.
        allow create, update, delete: if false;
      }

      match /participants/{userId} {
        allow read: if isMember(eventId);
        allow write: if false;
      }

      match /invites/{inviteId} {
        allow read, write: if false;
      }

      match /photos/{photoId} {
        // Only trusted callables publish/update/delete match metadata. This
        // prevents forged sourceUserId, matchedUserIds and confidence records.
        allow read: if isMember(eventId);
        allow create, update, delete: if false;
      }
    }

    match /transfers/{transferId} {
      allow read: if isSignedIn() &&
        (resource.data.requestingUserId == request.auth.uid ||
         resource.data.sourceUserId == request.auth.uid);
      allow create, update, delete: if false;
    }
  }
}
