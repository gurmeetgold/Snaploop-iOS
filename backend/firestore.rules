rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function memberPath(eventId, userId) {
      return /databases/$(database)/documents/events/$(eventId)/members/$(userId);
    }

    function isMember(eventId) {
      return isSignedIn() && exists(memberPath(eventId, request.auth.uid));
    }

    function isOrganizer(eventId) {
      return isMember(eventId) &&
        get(memberPath(eventId, request.auth.uid)).data.role == 'organizer';
    }

    function faceProfilePath(userId) {
      return /databases/$(database)/documents/users/$(userId)/faceProfile/current;
    }

    // Legacy photo documents have no per-participation binding and continue to
    // use the existing stable-face authorization during migration. New photo
    // documents contain matchedMembershipIds; for those, leave/rejoin must not
    // revive access from the previous Event participation.
    function currentMembershipGenerationMatches(eventId) {
      return resource.data.get('matchedMembershipIds', {}) is map
        && (
          resource.data.get('matchedMembershipIds', {}).get(request.auth.uid, '') == ''
          || (
            get(memberPath(eventId, request.auth.uid)).data.get('membershipId', '') != ''
            && resource.data.get('matchedMembershipIds', {}).get(request.auth.uid, '') ==
               get(memberPath(eventId, request.auth.uid)).data.get('membershipId', '')
          )
        );
    }

    function isMatchedInPhoto(eventId) {
      return isSignedIn()
        && resource.data.matchedUserIds is list
        && resource.data.matchedUserIds.hasAny([request.auth.uid])
        && resource.data.matchedFaceIdentityIds is map
        && exists(faceProfilePath(request.auth.uid))
        && resource.data.matchedFaceIdentityIds.get(request.auth.uid, '') != ''
        && resource.data.matchedFaceIdentityIds.get(request.auth.uid, '') ==
           get(faceProfilePath(request.auth.uid)).data.get('faceIdentityId', '')
        && currentMembershipGenerationMatches(eventId);
    }

    match /users/{userId} {
      allow read: if isSelf(userId);
      allow create, update, delete: if false;

      match /faceProfile/{doc} {
        allow read: if isSelf(userId);
        allow create, update, delete: if false;
      }

      match /privacy/{doc} {
        allow read: if isSelf(userId);
        allow write: if false;
      }

      match /eventRefs/{eventId} {
        allow read: if isSelf(userId);
        allow write: if false;
      }

      match /pendingInvites/{eventId} {
        allow read: if isSelf(userId);
        allow write: if false;
      }

      match /notifications/{notificationId} {
        allow read: if isSelf(userId);
        allow create, delete: if false;
        allow update: if isSelf(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      }
    }

    match /joinCodes/{code} {
      allow read, write: if false;
    }

    match /inviteTokens/{token} {
      allow read, write: if false;
    }

    match /events/{eventId} {
      allow get: if isMember(eventId);
      allow list: if false;
      allow create: if false;

      allow update: if isOrganizer(eventId)
        && resource.data.status == 'active'
        && request.resource.data.status == 'endedByOrganizer'
        && request.resource.data.id == resource.data.id
        && request.resource.data.joinCode == resource.data.joinCode
        && request.resource.data.inviteToken == resource.data.inviteToken
        && request.resource.data.creatorUserId == resource.data.creatorUserId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.name == resource.data.name
        && request.resource.data.category == resource.data.category
        && request.resource.data.get('coverImagePath', null) == resource.data.get('coverImagePath', null)
        && request.resource.data.get('locationName', null) == resource.data.get('locationName', null)
        && request.resource.data.startsAt == resource.data.startsAt
        && request.resource.data.endsAt == resource.data.endsAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']);

      allow delete: if false;

      match /members/{userId} {
        allow read: if isMember(eventId);
        allow create, update, delete: if false;
      }

      match /participants/{userId} {
        allow read, write: if false;
      }

      match /invites/{inviteId} {
        allow read, write: if false;
      }

      match /photos/{photoId} {
        // Access is tied to both the viewer's stable biometric identity and, for
        // newly published photos, the exact uninterrupted Event participation.
        // Same-person Face Setup refreshes preserve identity access; leave/rejoin
        // receives a new membershipId and cannot revive generation-bound photos.
        allow read: if isMember(eventId) && isMatchedInPhoto(eventId);
        allow create, update, delete: if false;
      }
    }

    match /transfers/{transferId} {
      allow read: if isSignedIn() &&
        (resource.data.requestingUserId == request.auth.uid ||
         resource.data.sourceUserId == request.auth.uid);
      allow create, update, delete: if false;
    }
  }
}
