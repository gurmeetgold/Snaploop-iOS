rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isMember(eventId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/events/$(eventId)/members/$(request.auth.uid));
    }

    function isOrganizer(eventId) {
      return isMember(eventId) &&
        get(/databases/$(database)/documents/events/$(eventId)/members/$(request.auth.uid)).data.role == 'organizer';
    }

    function validMVPEventDates(data) {
      return data.startsAt is timestamp
        && data.endsAt is timestamp
        && data.endsAt > data.startsAt
        && data.endsAt - data.startsAt <= duration.value(15, 'd')
        && data.startsAt >= request.time - duration.value(15, 'd')
        && data.startsAt <= request.time + duration.value(15, 'd')
        && data.endsAt >= request.time - duration.value(15, 'd')
        && data.endsAt <= request.time + duration.value(15, 'd');
    }

    match /users/{userId} {
      allow read, create, update, delete: if isSelf(userId);

      match /faceProfile/{doc} {
        allow read, write: if isSelf(userId);
      }

      match /privacy/{doc} {
        allow read, write: if isSelf(userId);
      }

      match /eventRefs/{eventId} {
        allow read: if isSelf(userId);
        allow write: if false;
      }

      match /notifications/{notificationId} {
        allow read: if isSelf(userId);
        allow create, delete: if false;
        allow update: if isSelf(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      }
    }

    match /joinCodes/{code} {
      allow read, write: if false;
    }

    match /inviteTokens/{token} {
      allow read, write: if false;
    }

    match /events/{eventId} {
      allow get: if isMember(eventId);
      allow list: if false;
      allow create: if false;

      allow update: if isOrganizer(eventId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.joinCode == resource.data.joinCode
        && request.resource.data.inviteToken == resource.data.inviteToken
        && request.resource.data.creatorUserId == resource.data.creatorUserId
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          (request.resource.data.startsAt == resource.data.startsAt
           && request.resource.data.endsAt == resource.data.endsAt)
          || validMVPEventDates(request.resource.data)
        );

      allow delete: if false;

      match /members/{userId} {
        allow read: if isMember(eventId);
        allow update: if isSelf(userId)
          && request.resource.data.role == resource.data.role;
        allow create, delete: if false;
      }

      match /participants/{userId} {
        allow read: if isMember(eventId);
        allow write: if false;
      }

      match /photos/{photoId} {
        allow read: if isMember(eventId);
        allow create: if isMember(eventId)
          && request.resource.data.sourceUserId == request.auth.uid
          && request.resource.data.eventId == eventId;
        allow update, delete: if isMember(eventId)
          && resource.data.sourceUserId == request.auth.uid;
      }
    }

    match /transfers/{transferId} {
      allow read: if isSignedIn() &&
        (resource.data.requestingUserId == request.auth.uid ||
         resource.data.sourceUserId == request.auth.uid);
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}
