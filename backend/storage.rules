rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function memberPath(eventId, userId) {
      return /databases/(default)/documents/events/$(eventId)/members/$(userId);
    }

    function photoPath(eventId, photoId) {
      return /databases/(default)/documents/events/$(eventId)/photos/$(photoId);
    }

    function faceProfilePath(userId) {
      return /databases/(default)/documents/users/$(userId)/faceProfile/current;
    }

    function isMember(eventId) {
      return isSignedIn() && firestore.exists(memberPath(eventId, request.auth.uid));
    }

    function isOrganizer(eventId) {
      return isMember(eventId) &&
        firestore.get(memberPath(eventId, request.auth.uid)).data.role == 'organizer';
    }

    function ownSharingEnabled(eventId) {
      return isMember(eventId) &&
        firestore.get(memberPath(eventId, request.auth.uid)).data.sharingEnabled == true;
    }

    function publishedMembershipGenerationMatches(eventId, photoId) {
      return firestore.get(photoPath(eventId, photoId)).data.get('matchedMembershipIds', {}) is map
        && (
          firestore.get(photoPath(eventId, photoId)).data.get('matchedMembershipIds', {}).get(request.auth.uid, '') == ''
          || (
            firestore.get(memberPath(eventId, request.auth.uid)).data.get('membershipId', '') != ''
            && firestore.get(photoPath(eventId, photoId)).data.get('matchedMembershipIds', {}).get(request.auth.uid, '') ==
               firestore.get(memberPath(eventId, request.auth.uid)).data.get('membershipId', '')
          )
        );
    }

    function publishedPhotoVisibleToViewer(eventId, ownerUserId, photoId) {
      return firestore.exists(photoPath(eventId, photoId))
        && firestore.exists(faceProfilePath(request.auth.uid))
        && firestore.get(photoPath(eventId, photoId)).data.sourceUserId == ownerUserId
        && firestore.get(photoPath(eventId, photoId)).data.matchedUserIds is list
        && firestore.get(photoPath(eventId, photoId)).data.matchedUserIds.hasAny([request.auth.uid])
        && firestore.get(photoPath(eventId, photoId)).data.matchedFaceIdentityIds is map
        && firestore.get(photoPath(eventId, photoId)).data.matchedFaceIdentityIds.get(request.auth.uid, '') != ''
        && firestore.get(photoPath(eventId, photoId)).data.matchedFaceIdentityIds.get(request.auth.uid, '') ==
           firestore.get(faceProfilePath(request.auth.uid)).data.get('faceIdentityId', '')
        && publishedMembershipGenerationMatches(eventId, photoId);
    }

    match /events/{eventId}/cover.jpg {
      allow read: if isMember(eventId);
      allow create, update: if isOrganizer(eventId)
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isOrganizer(eventId);
    }

    match /events/{eventId}/photos/{ownerUserId}/{photoId}/thumbnail.jpg {
      // Preview access follows the viewer's stable face identity and, for newly
      // published photos, the exact uninterrupted Event membership generation.
      allow read: if isMember(eventId)
        && publishedPhotoVisibleToViewer(eventId, ownerUserId, photoId);

      allow create, update: if request.auth.uid == ownerUserId
        && ownSharingEnabled(eventId)
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg';
      allow delete: if isMember(eventId) && request.auth.uid == ownerUserId;
    }

    match /events/{eventId}/transfers/{transferId}/{file} {
      allow read, write: if false;
    }
  }
}
