rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isMember(eventId) {
      return isSignedIn() &&
        firestore.exists(/databases/(default)/documents/events/$(eventId)/members/$(request.auth.uid));
    }

    function isOrganizer(eventId) {
      return isMember(eventId) &&
        firestore.get(/databases/(default)/documents/events/$(eventId)/members/$(request.auth.uid)).data.role == 'organizer';
    }

    match /events/{eventId}/cover.jpg {
      allow read: if isMember(eventId);
      allow write: if isOrganizer(eventId)
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Thumbnails are readable by event members. Only the source user's device
    // may write under its own UID folder.
    match /events/{eventId}/photos/{ownerUserId}/{photoId}/thumbnail.jpg {
      allow read: if isMember(eventId);
      allow write: if isMember(eventId)
        && request.auth.uid == ownerUserId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg';
    }

    // Originals are never directly exposed through normal client Storage rules.
    match /events/{eventId}/transfers/{transferId}/{file} {
      allow read, write: if false;
    }
  }
}
